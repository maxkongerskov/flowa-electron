.env
.env.*

# TypeScript incremental + helper intermediates
*.tsbuildinfo
build/helper/

# Generated by scripts/build-mac-icons.sh
build/mac/
build/icon.icns
.e2e/

# Local verification screenshots (personal desktop/dock)
docs/icon-check/
